# GEMINI_API_KEY: Fallback server Gemini AI API key (used only if no Admin API keys exist for Gemini and user has active free trial).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_EMAIL: Sole administrator Gmail account with access to /admin and /api/admin/* endpoints.
ADMIN_EMAIL="your-admin@gmail.com"

# Optional: Firebase Service Account JSON (or place serviceAccountKey.json in project root)
# Enables syncing all existing Firebase Auth accounts & Firestore collections into the Admin Dashboard.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ADMIN_ENCRYPTION_KEY: Optional high-entropy secret used to encrypt Admin API keys with AES-256-GCM.
# If omitted, a random 256-bit key is generated and stored in data/.master.key (0600 permissions).
ADMIN_ENCRYPTION_KEY=""

# Optional fallback provider keys (Admin-managed keys in the Admin Dashboard always take priority)
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
NVIDIA_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CEREBRAS_API_KEY=""
ALLOW_SERVER_PROVIDER_KEYS="true"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
