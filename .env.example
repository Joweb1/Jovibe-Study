# =============================================================================
# Jovibe Study — Environment Variables
# =============================================================================

# ADMIN_EMAIL: Sole administrator Gmail account with access to /admin and /api/admin/* endpoints.
ADMIN_EMAIL="your-admin@gmail.com"

# PERMANENT ADMIN KEY PERSISTENCE (Recommended for Render Free / ephemeral hosts)
# 1. FIREBASE_SERVICE_ACCOUNT_JSON: Single-line Firebase Service Account JSON.
#    Enables automatic restore of encrypted Admin API keys & settings from Firestore on cold start,
#    as well as syncing all Firebase Auth users & courses into the Admin Dashboard.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# 2. ADMIN_ENCRYPTION_KEY: Permanent high-entropy secret (32+ random characters) used to encrypt
#    Admin API keys with AES-256-GCM before saving to Firestore/SQLite.
#    IMPORTANT: Set this explicitly on Render so encrypted keys remain decryptable after restarts/deploys!
ADMIN_ENCRYPTION_KEY=""

# =============================================================================
# MULTI-KEY .ENV FALLBACK & AUTOMATIC ROTATION
# Used whenever no healthy Admin Dashboard keys are available for a provider.
# You can add as many numbered keys as you want (*_1, *_2, *_3, ...) or comma-separated in *_KEYS.
# The server automatically rotates across healthy keys (LRU) and cools down rate-limited keys!
# =============================================================================

# Google Gemini (primary + unlimited numbered keys)
GEMINI_API_KEY=""
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""
# GEMINI_API_KEYS="keyA,keyB,keyC"

# OpenRouter (supports OPENROUTER_API_KEY, OPENROUTER_API_KEY_1, OPENROUTER_API_KEY_2, ...)
OPENROUTER_API_KEY=""
OPENROUTER_API_KEY_1=""
OPENROUTER_API_KEY_2=""

# Groq (supports GROQ_API_KEY, GROQ_API_KEY_1, GROQ_API_KEY_2, ...)
GROQ_API_KEY=""
GROQ_API_KEY_1=""
GROQ_API_KEY_2=""

# NVIDIA NIM (supports NVIDIA_API_KEY, NVIDIA_API_KEY_1, NVIDIA_API_KEY_2, ...)
NVIDIA_API_KEY=""
NVIDIA_API_KEY_1=""
NVIDIA_API_KEY_2=""

# Cloudflare Workers AI (pair with CLOUDFLARE_ACCOUNT_ID or use ACCOUNT_ID:API_TOKEN directly)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_API_TOKEN_1=""
CLOUDFLARE_API_TOKEN_2=""
# Optional per-key account IDs if keys belong to different Cloudflare accounts:
# CLOUDFLARE_ACCOUNT_ID_1=""
# CLOUDFLARE_ACCOUNT_ID_2=""

# Cerebras (supports CEREBRAS_API_KEY, CEREBRAS_API_KEY_1, CEREBRAS_API_KEY_2, ...)
CEREBRAS_API_KEY=""
CEREBRAS_API_KEY_1=""
CEREBRAS_API_KEY_2=""

ALLOW_SERVER_PROVIDER_KEYS="true"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
