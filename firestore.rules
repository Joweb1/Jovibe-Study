            && incoming().courseId == existing().courseId
            && incoming().sourceId == existing().sourceId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt'])
