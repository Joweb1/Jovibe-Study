          && incoming().longestStreak >= existing().longestStreak
          && incoming().totalStudyDays >= existing().totalStudyDays
          && incoming().totalStudyDays <= existing().totalStudyDays + 1
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'currentStreak', 'longestStreak', 'totalStudyDays', 'freezeBalance',
            'lastQualifyingDate', 'lastEvaluatedDate', 'pendingClaimDate',
            'pendingStreakCount', 'timezoneOffsetMinutes', 'updatedAt'
