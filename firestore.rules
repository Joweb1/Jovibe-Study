      // Daily Streak Calendar Records (keyed by local YYYY-MM-DD)
      match /streakDays/{dateKey} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidDateKey(dateKey);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidDateKey(dateKey)
