      // Joined Shared Courses (Member's personal bookmark list)
      match /joinedCourses/{courseId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId)
          && isValidJoinedCourse(incoming(), userId, courseId)
