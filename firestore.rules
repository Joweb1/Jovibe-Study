        // Automatic Study Sessions (Private per learner; works for both owned & joined courses)
        match /studySessions/{sessionId} {
          allow get: if (isAdmin() || (isOwner(userId) && hasCourseWorkspace(userId, courseId)))
            && isValidId(userId) && isValidId(courseId) && isValidId(sessionId);
          allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();
          allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId) && isValidId(sessionId)
            && isValidAutomaticStudySession(incoming(), userId, courseId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && hasCourseWorkspace(userId, courseId);
          allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId) && isValidId(sessionId)
            && isValidAutomaticStudySession(incoming(), userId, courseId)
            && existing().status != 'completed'
            && incoming().userId == existing().userId
            && incoming().courseId == existing().courseId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastCheckpointId', 'nextAction', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['latestStudentAnswer', 'nextAction', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'studyPlan', 'currentUnitIndex', 'completedUnitIds',
                'currentObjective', 'currentQuestion', 'latestStudentAnswer',
                'evaluationFeedback', 'scores', 'topicMastery', 'topicsRequiringReview',
                'lastCheckpointId', 'nextAction', 'activeSegmentId', 'updatedAt'
              ])
            )
            && hasCourseWorkspace(userId, courseId);
          allow delete: if isVerified() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId) && isValidId(sessionId);

          // Session Segments
          match /segments/{segmentId} {
            allow get: if (isAdmin() || (isOwner(userId) && studySessionExists(userId, courseId, sessionId)))
              && isValidId(userId) && isValidId(courseId) && isValidId(sessionId) && isValidId(segmentId);
            allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();
            allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId) && isValidId(sessionId) && isValidId(segmentId)
              && isValidStudySessionSegment(incoming(), userId, courseId, sessionId)
              && incoming().createdAt == request.time
              && incoming().updatedAt == request.time
              && studySessionExists(userId, courseId, sessionId);
            allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId) && isValidId(sessionId) && isValidId(segmentId)
              && isValidStudySessionSegment(incoming(), userId, courseId, sessionId)
              && incoming().userId == existing().userId
              && incoming().courseId == existing().courseId
              && incoming().sessionId == existing().sessionId
              && incoming().segmentIndex == existing().segmentIndex
              && incoming().createdAt == existing().createdAt
              && incoming().updatedAt == request.time
              && (
                incoming().diff(existing()).affectedKeys().hasOnly(['entries', 'tokenEstimate', 'updatedAt'])
              )
              && studySessionExists(userId, courseId, sessionId);
            allow delete: if isVerified() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId) && isValidId(sessionId) && isValidId(segmentId);
          }

          // Session Checkpoints
          match /checkpoints/{checkpointId} {
            allow get: if (isAdmin() || (isOwner(userId) && studySessionExists(userId, courseId, sessionId)))
              && isValidId(userId) && isValidId(courseId) && isValidId(sessionId) && isValidId(checkpointId);
            allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();
            allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId) && isValidId(sessionId) && isValidId(checkpointId)
              && isValidStudySessionCheckpoint(incoming(), userId, courseId, sessionId)
              && incoming().createdAt == request.time
              && studySessionExists(userId, courseId, sessionId);
            allow update: if false;
            allow delete: if isVerified() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId) && isValidId(sessionId) && isValidId(checkpointId);
          }
        }

        // Study History Records (Private per learner; works for both owned & joined courses)
        match /studyHistory/{historyId} {
          allow get: if (isAdmin() || (isOwner(userId) && hasCourseWorkspace(userId, courseId)))
            && isValidId(userId) && isValidId(courseId) && isValidId(historyId);
          allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();
          allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId) && isValidId(historyId)
            && isValidStudyHistoryRecord(incoming(), userId, courseId)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && hasCourseWorkspace(userId, courseId);
          allow update: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId) && isValidId(historyId)
            && isValidStudyHistoryRecord(incoming(), userId, courseId)
            && existing().status != 'completed'
            && incoming().userId == existing().userId
            && incoming().courseId == existing().courseId
            && incoming().sessionType == existing().sessionType
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'score', 'maxScore', 'percentage', 'correctCount',
                'incorrectCount', 'skippedCount', 'durationSeconds', 'summary',
                'weaknesses', 'details', 'updatedAt'
              ])
            )
            && hasCourseWorkspace(userId, courseId);
          allow delete: if isVerified() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId) && isValidId(historyId);
        }
      }
    }

    // =========================================================================
    // Persistent Admin Vault (Strictly Sole Verified Admin Only)
    // Stores ONLY AES-256-GCM encrypted API keys & platform settings.
    // =========================================================================

    function isValidAdminApiKey(data, keyId) {
      return data.keys().hasOnly([
        'id', 'provider', 'label', 'encryptedKey', 'iv', 'authTag', 'keyMask',
        'enabled', 'status', 'cooldownUntilMs', 'priority',
        'totalRequests', 'failedRequests', 'rateLimitHits', 'failoverCount',
        'lastUsedAtMs', 'lastError', 'createdAtMs', 'updatedAtMs'
      ])
      && data.keys().hasAll([
        'id', 'provider', 'label', 'encryptedKey', 'iv', 'authTag', 'keyMask',
        'enabled', 'status', 'cooldownUntilMs', 'priority',
        'totalRequests', 'failedRequests', 'rateLimitHits', 'failoverCount',
        'lastUsedAtMs', 'lastError', 'createdAtMs', 'updatedAtMs'
      ])
      && data.id == keyId
      && isValidId(data.id)
      && data.provider in ['gemini', 'openrouter', 'groq', 'cloudflare', 'nvidia_nim']
      && isNonEmptyString(data.label, 120)
      && isNonEmptyString(data.encryptedKey, 4096)
      && isNonEmptyString(data.iv, 128)
      && isNonEmptyString(data.authTag, 128)
      && isNonEmptyString(data.keyMask, 64)
      && data.enabled is bool
      && data.status in ['active', 'cooldown', 'quota_exhausted', 'invalid']
      && data.cooldownUntilMs is int && data.cooldownUntilMs >= 0
      && data.priority is int && data.priority >= 1 && data.priority <= 1000
      && data.totalRequests is int && data.totalRequests >= 0
      && data.failedRequests is int && data.failedRequests >= 0
      && data.rateLimitHits is int && data.rateLimitHits >= 0
      && data.failoverCount is int && data.failoverCount >= 0
      && data.lastUsedAtMs is int && data.lastUsedAtMs >= 0
      && isBoundedString(data.lastError, 500)
      && data.createdAtMs is int && data.createdAtMs > 0
      && data.updatedAtMs is int && data.updatedAtMs > 0;
    }

    function isValidAdminSetting(data, settingKey) {
      return data.keys().hasOnly(['key', 'valueJson', 'updatedAtMs', 'updatedBy'])
      && data.keys().hasAll(['key', 'valueJson', 'updatedAtMs', 'updatedBy'])
      && data.key == settingKey
      && data.key in ['feature_flags', 'quota_config']
      && isNonEmptyString(data.valueJson, 20000)
      && data.updatedAtMs is int && data.updatedAtMs > 0
      && isBoundedString(data.updatedBy, 160);
    }

    match /adminApiKeys/{keyId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(keyId) && isValidAdminApiKey(incoming(), keyId);
      allow update: if isAdmin() && isValidId(keyId)
        && isValidAdminApiKey(incoming(), keyId)
        && incoming().id == existing().id
        && incoming().provider == existing().provider
        && incoming().createdAtMs == existing().createdAtMs;
      allow delete: if isAdmin() && isValidId(keyId);
    }

    match /adminSettings/{settingKey} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidAdminSetting(incoming(), settingKey);
      allow update: if isAdmin()
        && isValidAdminSetting(incoming(), settingKey)
        && incoming().key == existing().key;
      allow delete: if isAdmin();
    }
  }
}
