rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'nahjonah00@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOptionalId(id) {
      return id is string && (id.size() == 0 || isValidId(id));
    }

    function isValidDateKey(val) {
      return val is string && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptionalDateKey(val) {
      return val is string && (val.size() == 0 || isValidDateKey(val));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isBoundedString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isBoundedStringList(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || arr[0] is string);
    }

    function isBoundedMapList(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || arr[0] is map);
    }

    function courseExists(userId, courseId) {
      return exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId));
    }

    function joinedCourseExists(userId, courseId) {
      return exists(/databases/$(database)/documents/users/$(userId)/joinedCourses/$(courseId));
    }

    function hasCourseWorkspace(userId, courseId) {
      return courseExists(userId, courseId) || joinedCourseExists(userId, courseId) || isAdmin();
    }

    function isCourseMember(authorId, courseId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(authorId)/courses/$(courseId)/members/$(request.auth.uid));
    }

    function courseIsPublicWithToken(authorId, courseId, token) {
      let courseDoc = get(/databases/$(database)/documents/users/$(authorId)/courses/$(courseId));
      return courseDoc != null
        && courseDoc.data.isPublic == true
        && isValidId(courseDoc.data.shareToken)
        && courseDoc.data.shareToken == token;
    }

    function conversationExists(userId, courseId, conversationId) {
      return exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId)/conversations/$(conversationId));
    }

    function studySessionExists(userId, courseId, sessionId) {
      return exists(/databases/$(database)/documents/users/$(userId)/courses/$(courseId)/studySessions/$(sessionId));
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap)
    // =========================================================================

    function isValidUserPreferences(prefs) {
      return prefs is map
        && prefs.keys().hasAll(['defaultModel', 'tutorSourceMode', 'voiceEnabled', 'voiceRate', 'defaultDifficulty'])
        && prefs.keys().hasOnly(['defaultModel', 'tutorSourceMode', 'voiceEnabled', 'voiceRate', 'defaultDifficulty', 'ttsVoice'])
        && isNonEmptyString(prefs.defaultModel, 80)
        && prefs.tutorSourceMode in ['materials_only', 'materials_plus_ai', 'general_ai']
        && prefs.voiceEnabled is bool
        && prefs.voiceRate is number && prefs.voiceRate >= 0.5 && prefs.voiceRate <= 2.0
        && prefs.defaultDifficulty in ['foundational', 'standard', 'advanced']
        && (!('ttsVoice' in prefs) || prefs.ttsVoice in ['Kore', 'Puck', 'Charon', 'Fenrir', 'Zephyr']);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'photoURL', 'activeCourseId', 'preferences', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'activeCourseId', 'preferences', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && isBoundedString(data.displayName, 120)
        && isNonEmptyString(data.email, 254)
        && isBoundedString(data.photoURL, 500)
        && isOptionalId(data.activeCourseId)
        && isValidUserPreferences(data.preferences)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourse(data, userId) {
      return data.keys().hasAll(['userId', 'code', 'name', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'code', 'name', 'description', 'isPublic', 'shareToken', 'authorName', 'createdAt', 'updatedAt'])
        && (data.userId == request.auth.uid || isAdmin())
        && data.userId == userId
        && isNonEmptyString(data.code, 32)
        && isNonEmptyString(data.name, 120)
        && isBoundedString(data.description, 1000)
        && (!('isPublic' in data) || data.isPublic is bool)
        && (!('shareToken' in data) || isOptionalId(data.shareToken))
        && (!('authorName' in data) || isBoundedString(data.authorName, 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseShare(data, shareToken) {
      return data.keys().hasAll(['shareToken', 'authorId', 'courseId', 'courseCode', 'courseName', 'courseDescription', 'authorName', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['shareToken', 'authorId', 'courseId', 'courseCode', 'courseName', 'courseDescription', 'authorName', 'active', 'createdAt', 'updatedAt'])
        && data.shareToken == shareToken
        && isValidId(data.authorId)
        && isValidId(data.courseId)
        && isNonEmptyString(data.courseCode, 32)
        && isNonEmptyString(data.courseName, 120)
        && isBoundedString(data.courseDescription, 1000)
        && isBoundedString(data.authorName, 120)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseMember(data, authorId, courseId, memberUid) {
      return data.keys().hasAll(['memberUid', 'authorId', 'courseId', 'displayName', 'photoURL', 'groupId', 'role', 'shareToken', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['memberUid', 'authorId', 'courseId', 'displayName', 'photoURL', 'groupId', 'role', 'shareToken', 'joinedAt', 'updatedAt'])
        && data.memberUid == memberUid
        && data.authorId == authorId
        && data.courseId == courseId
        && isBoundedString(data.displayName, 120)
        && isBoundedString(data.photoURL, 500)
        && isOptionalId(data.groupId)
        && data.role == 'member'
        && isValidId(data.shareToken)
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseGroup(data, authorId, courseId) {
      return data.keys().hasAll(['authorId', 'courseId', 'name', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorId', 'courseId', 'name', 'description', 'createdAt', 'updatedAt'])
        && (data.authorId == request.auth.uid || isAdmin())
        && data.authorId == authorId
        && data.courseId == courseId
        && isNonEmptyString(data.name, 80)
        && isBoundedString(data.description, 300)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJoinedCourse(data, userId, courseId) {
      return data.keys().hasAll(['userId', 'authorId', 'courseId', 'courseCode', 'courseName', 'courseDescription', 'authorName', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'authorId', 'courseId', 'courseCode', 'courseName', 'courseDescription', 'authorName', 'joinedAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && isValidId(data.authorId)
        && data.authorId != userId
        && data.courseId == courseId
        && isNonEmptyString(data.courseCode, 32)
        && isNonEmptyString(data.courseName, 120)
        && isBoundedString(data.courseDescription, 1000)
        && isBoundedString(data.authorName, 120)
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPersonalSourceNote(data, userId, courseId, sourceId) {
      return data.keys().hasAll(['userId', 'courseId', 'sourceId', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'courseId', 'sourceId', 'notes', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.courseId == courseId
        && data.sourceId == sourceId
        && isBoundedString(data.notes, 20000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTopic(data, userId, courseId) {
      return data.keys().hasAll(['userId', 'courseId', 'name', 'description', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'courseId', 'name', 'description', 'order', 'createdAt', 'updatedAt'])
        && (data.userId == request.auth.uid || isAdmin())
        && data.userId == userId
        && data.courseId == courseId
        && isNonEmptyString(data.name, 120)
        && isBoundedString(data.description, 600)
        && data.order is number && data.order >= 0 && data.order <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudySource(data, userId, courseId) {
      return data.keys().hasAll([
          'userId', 'courseId', 'topicId', 'title', 'materialType',
          'extractedContent', 'sections', 'pageOrSlideCount',
          'processingStatus', 'studentNotes', 'originalFileName',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'courseId', 'topicId', 'title', 'materialType',
          'extractedContent', 'sections', 'pageOrSlideCount',
          'processingStatus', 'studentNotes', 'originalFileName',
          'createdAt', 'updatedAt'
        ])
        && (data.userId == request.auth.uid || isAdmin())
        && data.userId == userId
        && data.courseId == courseId
        && isOptionalId(data.topicId)
        && isNonEmptyString(data.title, 200)
        && data.materialType in ['pdf', 'slides', 'textbook_photo', 'handwritten_notes', 'scanned_doc', 'typed_notes', 'pasted_text', 'other']
        && isBoundedString(data.extractedContent, 450000)
        && isBoundedMapList(data.sections, 300)
        && data.pageOrSlideCount is number && data.pageOrSlideCount >= 0 && data.pageOrSlideCount <= 2000
        && data.processingStatus in ['ready', 'needs_review', 'failed']
        && isBoundedString(data.studentNotes, 20000)
        && isBoundedString(data.originalFileName, 260)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTutorConversation(data, userId, courseId) {
      return data.keys().hasAll(['userId', 'courseId', 'title', 'sourceMode', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'courseId', 'title', 'sourceMode', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.courseId == courseId
        && isNonEmptyString(data.title, 160)
        && data.sourceMode in ['materials_only', 'materials_plus_ai', 'general_ai']
        && isBoundedString(data.lastMessagePreview, 400)
        && data.messageCount is number && data.messageCount >= 0 && data.messageCount <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTutorMessage(data, userId, courseId, conversationId) {
      return data.keys().hasAll(['userId', 'courseId', 'conversationId', 'role', 'content', 'sourceReferences', 'saved', 'createdAt'])
        && data.keys().hasOnly(['userId', 'courseId', 'conversationId', 'role', 'content', 'sourceReferences', 'saved', 'createdAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.courseId == courseId
        && data.conversationId == conversationId
        && data.role in ['user', 'assistant']
        && isNonEmptyString(data.content, 40000)
        && isBoundedMapList(data.sourceReferences, 30)
        && data.saved is bool
        && data.createdAt is timestamp;
    }

    function isValidSavedStudyMaterial(data, userId, courseId) {
      return data.keys().hasAll(['userId', 'courseId', 'topicId', 'title', 'type', 'content', 'sourceReferences', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'courseId', 'topicId', 'title', 'type', 'content', 'sourceReferences', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.courseId == courseId
        && isOptionalId(data.topicId)
        && isNonEmptyString(data.title, 200)
        && data.type in ['flashcards', 'cbt', 'fill_in_the_gap', 'exam_prep', 'tutor_response', 'summary', 'study_guide', 'explanation', 'custom_note']
        && data.content is map
        && isBoundedMapList(data.sourceReferences, 50)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAutomaticStudySession(data, userId, courseId) {
      return data.keys().hasAll([
          'userId', 'courseId', 'title', 'selectedTopicIds', 'customInstructions',
          'difficulty', 'status', 'studyPlan', 'currentUnitIndex', 'completedUnitIds',
          'currentObjective', 'currentQuestion', 'latestStudentAnswer', 'evaluationFeedback',
          'scores', 'topicMastery', 'topicsRequiringReview', 'lastCheckpointId',
          'nextAction', 'activeSegmentId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'courseId', 'title', 'selectedTopicIds', 'customInstructions',
          'difficulty', 'status', 'studyPlan', 'currentUnitIndex', 'completedUnitIds',
          'currentObjective', 'currentQuestion', 'latestStudentAnswer', 'evaluationFeedback',
          'scores', 'topicMastery', 'topicsRequiringReview', 'lastCheckpointId',
          'nextAction', 'activeSegmentId', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.courseId == courseId
        && isNonEmptyString(data.title, 200)
        && isBoundedStringList(data.selectedTopicIds, 50)
        && isBoundedString(data.customInstructions, 2000)
        && data.difficulty in ['foundational', 'standard', 'advanced']
        && data.status in ['planning', 'active', 'paused', 'completed']
        && isBoundedMapList(data.studyPlan, 100)
        && data.currentUnitIndex is number && data.currentUnitIndex >= 0 && data.currentUnitIndex <= 100
        && isBoundedStringList(data.completedUnitIds, 100)
        && isBoundedString(data.currentObjective, 600)
        && isBoundedString(data.currentQuestion, 2000)
        && isBoundedString(data.latestStudentAnswer, 10000)
        && data.evaluationFeedback is map
        && isBoundedMapList(data.scores, 200)
        && data.topicMastery is map
        && isBoundedStringList(data.topicsRequiringReview, 50)
        && isOptionalId(data.lastCheckpointId)
        && isBoundedString(data.nextAction, 300)
        && isOptionalId(data.activeSegmentId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudySessionSegment(data, userId, courseId, sessionId) {
      return data.keys().hasAll(['userId', 'courseId', 'sessionId', 'segmentIndex', 'summaryFromCheckpoint', 'entries', 'tokenEstimate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'courseId', 'sessionId', 'segmentIndex', 'summaryFromCheckpoint', 'entries', 'tokenEstimate', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.courseId == courseId
        && data.sessionId == sessionId
        && data.segmentIndex is number && data.segmentIndex >= 0 && data.segmentIndex <= 500
        && isBoundedString(data.summaryFromCheckpoint, 15000)
        && isBoundedMapList(data.entries, 120)
        && data.tokenEstimate is number && data.tokenEstimate >= 0 && data.tokenEstimate <= 500000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudySessionCheckpoint(data, userId, courseId, sessionId) {
      return data.keys().hasAll([
          'userId', 'courseId', 'sessionId', 'reason', 'summary',
          'currentUnitIndex', 'completedUnitIds', 'nextAction',
          'masterySnapshot', 'weaknesses', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'courseId', 'sessionId', 'reason', 'summary',
          'currentUnitIndex', 'completedUnitIds', 'nextAction',
          'masterySnapshot', 'weaknesses', 'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.courseId == courseId
        && data.sessionId == sessionId
        && data.reason in ['lesson_completed', 'question_answered', 'evaluation_completed', 'topic_completed', 'paused', 'compaction']
        && isBoundedString(data.summary, 15000)
        && data.currentUnitIndex is number && data.currentUnitIndex >= 0 && data.currentUnitIndex <= 100
        && isBoundedStringList(data.completedUnitIds, 100)
        && isBoundedString(data.nextAction, 300)
        && data.masterySnapshot is map
        && isBoundedStringList(data.weaknesses, 50)
        && data.createdAt is timestamp;
    }

    function isValidStudyHistoryRecord(data, userId, courseId) {
      return data.keys().hasAll([
          'userId', 'courseId', 'sessionType', 'title', 'topicIds', 'status',
          'score', 'maxScore', 'percentage', 'correctCount', 'incorrectCount',
          'skippedCount', 'durationSeconds', 'summary', 'weaknesses', 'details',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'courseId', 'sessionType', 'title', 'topicIds', 'status',
          'score', 'maxScore', 'percentage', 'correctCount', 'incorrectCount',
          'skippedCount', 'durationSeconds', 'summary', 'weaknesses', 'details',
          'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.courseId == courseId
        && data.sessionType in ['tutor', 'flashcards', 'cbt', 'fill_in_the_gap', 'exam_prep', 'automatic_study']
        && isNonEmptyString(data.title, 200)
        && isBoundedStringList(data.topicIds, 50)
        && data.status in ['in_progress', 'paused', 'completed']
        && data.score is number && data.score >= 0 && data.score <= 10000
        && data.maxScore is number && data.maxScore >= 0 && data.maxScore <= 10000
        && data.percentage is number && data.percentage >= 0 && data.percentage <= 100
        && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= 10000
        && data.incorrectCount is number && data.incorrectCount >= 0 && data.incorrectCount <= 10000
        && data.skippedCount is number && data.skippedCount >= 0 && data.skippedCount <= 10000
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 864000
        && isBoundedString(data.summary, 4000)
        && isBoundedStringList(data.weaknesses, 50)
        && data.details is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStreakProfile(data, userId) {
      return data.keys().hasAll([
          'userId', 'currentStreak', 'longestStreak', 'totalStudyDays', 'freezeBalance',
          'lastQualifyingDate', 'lastEvaluatedDate', 'pendingClaimDate', 'pendingStreakCount',
          'accountCreatedDate', 'timezoneOffsetMinutes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'currentStreak', 'longestStreak', 'totalStudyDays', 'freezeBalance',
          'lastQualifyingDate', 'lastEvaluatedDate', 'pendingClaimDate', 'pendingStreakCount',
          'accountCreatedDate', 'timezoneOffsetMinutes', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.currentStreak is number && data.currentStreak >= 0 && data.currentStreak <= 50000
        && data.longestStreak is number && data.longestStreak >= 0 && data.longestStreak <= 50000
        && data.longestStreak >= data.currentStreak
        && data.totalStudyDays is number && data.totalStudyDays >= 0 && data.totalStudyDays <= 50000
        && data.freezeBalance is number && data.freezeBalance >= 0 && data.freezeBalance <= 50000
        && isOptionalDateKey(data.lastQualifyingDate)
        && isOptionalDateKey(data.lastEvaluatedDate)
        && isOptionalDateKey(data.pendingClaimDate)
        && data.pendingStreakCount is number && data.pendingStreakCount >= 0 && data.pendingStreakCount <= 50000
        && isValidDateKey(data.accountCreatedDate)
        && data.timezoneOffsetMinutes is number && data.timezoneOffsetMinutes >= -840 && data.timezoneOffsetMinutes <= 840
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyStreakRecord(data, userId, dateKey) {
      return data.keys().hasAll([
          'dateKey', 'userId', 'status', 'streakCount', 'qualifyingActivitiesCount',
          'firstActivityType', 'firstActivityTitle', 'freezeAwarded', 'freezeConsumed',
          'claimedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateKey', 'userId', 'status', 'streakCount', 'qualifyingActivitiesCount',
          'firstActivityType', 'firstActivityTitle', 'freezeAwarded', 'freezeConsumed',
          'claimedAt', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.dateKey == dateKey
        && isValidDateKey(dateKey)
        && data.status in ['pending_claim', 'claimed', 'frozen', 'missed']
        && data.streakCount is number && data.streakCount >= 0 && data.streakCount <= 50000
        && data.qualifyingActivitiesCount is number && data.qualifyingActivitiesCount >= 0 && data.qualifyingActivitiesCount <= 10000
        && data.firstActivityType in ['', 'cbt', 'flashcards', 'fill_in_the_gap', 'exam_prep', 'automatic_study', 'tutor', 'live', 'shared_library']
        && isBoundedString(data.firstActivityTitle, 140)
        && data.freezeAwarded is bool
        && data.freezeConsumed is bool
        && (data.claimedAt == null || data.claimedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFreezeLedgerEntry(data, userId, entryId) {
      return data.keys().hasAll(['userId', 'dateKey', 'action', 'delta', 'balanceAfter', 'createdAt'])
        && data.keys().hasOnly(['userId', 'dateKey', 'action', 'delta', 'balanceAfter', 'createdAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && isValidDateKey(data.dateKey)
        && data.balanceAfter is number && data.balanceAfter >= 0 && data.balanceAfter <= 50000
        && data.createdAt is timestamp
        && (
          (entryId == 'init_grant' && data.action == 'initial_grant' && data.delta == 10 && data.balanceAfter == 10) ||
          (entryId == 'earn_' + data.dateKey && data.action == 'earned' && data.delta == 1) ||
          (entryId == 'consume_' + data.dateKey && data.action == 'consumed' && data.delta == -1)
        );
    }

    function isValidStudyActivityEvent(data, userId) {
      return data.keys().hasAll([
          'userId', 'courseId', 'courseCode', 'isSharedCourse', 'activityType',
          'title', 'dateKey', 'durationSeconds', 'score', 'maxScore', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'courseId', 'courseCode', 'isSharedCourse', 'activityType',
          'title', 'dateKey', 'durationSeconds', 'score', 'maxScore', 'summary', 'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.userId == userId
        && isNonEmptyString(data.courseId, 120)
        && isNonEmptyString(data.courseCode, 40)
        && data.isSharedCourse is bool
        && data.activityType in ['cbt', 'flashcards', 'fill_in_the_gap', 'exam_prep', 'automatic_study', 'tutor', 'live', 'shared_library']
        && isNonEmptyString(data.title, 180)
        && isValidDateKey(data.dateKey)
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && (data.score == null || (data.score is number && data.score >= 0 && data.score <= 10000))
        && (data.maxScore == null || (data.maxScore is number && data.maxScore >= 0 && data.maxScore <= 10000))
        && isBoundedString(data.summary, 500)
        && data.createdAt is timestamp;
    }

    function isValidAppUsageSummary(data, userId) {
      return data.keys().hasAll(['userId', 'totalAppSeconds', 'totalActiveLearningSeconds', 'lastActiveDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'totalAppSeconds', 'totalActiveLearningSeconds', 'lastActiveDate', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.totalAppSeconds is number && data.totalAppSeconds >= 0 && data.totalAppSeconds <= 1000000000
        && data.totalActiveLearningSeconds is number && data.totalActiveLearningSeconds >= 0 && data.totalActiveLearningSeconds <= 1000000000
        && isValidDateKey(data.lastActiveDate)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppUsageDailyRecord(data, userId, dateKey) {
      return data.keys().hasAll(['dateKey', 'userId', 'appSeconds', 'activeLearningSeconds', 'sessionsCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['dateKey', 'userId', 'appSeconds', 'activeLearningSeconds', 'sessionsCount', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.dateKey == dateKey
        && isValidDateKey(dateKey)
        && data.appSeconds is number && data.appSeconds >= 0 && data.appSeconds <= 86400
        && data.activeLearningSeconds is number && data.activeLearningSeconds >= 0 && data.activeLearningSeconds <= 86400
        && data.sessionsCount is number && data.sessionsCount >= 0 && data.sessionsCount <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Public Invite Link Lookup (PII-Free, Token-Gated)
    // =========================================================================

    match /courseShares/{shareToken} {
      allow get: if isSignedIn() && isValidId(shareToken);
      allow list: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
      allow create: if isVerified() && isValidId(shareToken)
        && isValidCourseShare(incoming(), shareToken)
        && (incoming().authorId == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && courseExists(incoming().authorId, incoming().courseId);
      allow update: if isVerified() && isValidId(shareToken)
        && (existing().authorId == request.auth.uid || isAdmin())
        && isValidCourseShare(incoming(), shareToken)
        && incoming().authorId == existing().authorId
        && incoming().courseId == existing().courseId
        && incoming().shareToken == existing().shareToken
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['courseCode', 'courseName', 'courseDescription', 'authorName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['courseCode', 'courseName', 'courseDescription', 'authorName', 'active', 'updatedAt'])
        );
      allow delete: if isVerified() && isValidId(shareToken) && (existing().authorId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // User-Scoped Collections
    // =========================================================================

    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
