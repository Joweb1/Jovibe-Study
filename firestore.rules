        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId);
      }

      // Courses (Owned by userId; shared read-only with active members; read-only for sole admin)
      match /courses/{courseId} {
        allow get: if (isAdmin() || isOwner(userId) || isCourseMember(userId, courseId)) && isValidId(userId) && isValidId(courseId);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(courseId)
