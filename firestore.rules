        allow list: if isAdmin();
        allow create: if isVerified() && isOwner(userId) && isValidId(userId) && docId == 'current'
          && isValidStreakProfile(incoming(), userId)
          && incoming().freezeBalance == 10
          && incoming().currentStreak == 0
          && incoming().longestStreak == 0
          && incoming().totalStudyDays == 0
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isOwner(userId) && isValidId(userId) && docId == 'current'
