              incoming().diff(existing()).affectedKeys().hasOnly(['extractedContent', 'sections', 'processingStatus', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['studentNotes', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['title', 'topicId', 'materialType', 'extractedContent', 'sections', 'processingStatus', 'studentNotes', 'updatedAt'])
            )
            && courseExists(userId, courseId);
          allow delete: if isVerified() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId) && isValidId(sourceId);
