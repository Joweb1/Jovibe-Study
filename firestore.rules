            && incoming().joinedAt == request.time
            && incoming().updatedAt == request.time
            && courseIsPublicWithToken(userId, courseId, incoming().shareToken);
          allow update: if isVerified() && isValidId(userId) && isValidId(courseId) && isValidId(memberUid)
            && isValidCourseMember(incoming(), userId, courseId, memberUid)
            && incoming().memberUid == existing().memberUid
            && incoming().authorId == existing().authorId
            && incoming().courseId == existing().courseId
            && incoming().role == existing().role
            && incoming().shareToken == existing().shareToken
            && incoming().joinedAt == existing().joinedAt
            && incoming().updatedAt == request.time
            && (
              ((isOwner(userId) || isAdmin()) && incoming().diff(existing()).affectedKeys().hasOnly(['groupId', 'updatedAt'])) ||
              (isOwner(memberUid) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']))
            );
          allow delete: if isVerified() && (isOwner(userId) || isOwner(memberUid) || isAdmin())
            && isValidId(userId) && isValidId(courseId) && isValidId(memberUid);
