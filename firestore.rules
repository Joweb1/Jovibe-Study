        allow delete: if isVerified() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId);

        // Shared Course Members (Source of truth for access & instant revocation)
        match /members/{memberUid} {
          allow get: if (isAdmin() || isOwner(userId) || isOwner(memberUid)) && isValidId(userId) && isValidId(courseId) && isValidId(memberUid);
          allow list: if (isOwner(userId) && resource.data.authorId == request.auth.uid) || isAdmin();
