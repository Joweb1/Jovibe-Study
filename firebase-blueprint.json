        "courseId",
        "topicId",
        "title",
        "materialType",
        "extractedContent",
        "sections",
        "pageOrSlideCount",
        "processingStatus",
        "studentNotes",
        "originalFileName",
        "createdAt",
        "updatedAt"
      ]
